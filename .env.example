# =============================================================================
# Budget Manager — variables para docker compose (copiar a .env)
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
# =============================================================================

# --- MySQL en el host (opcional) --------------------------------------------
# Por defecto el compose principal NO publica el puerto de MySQL (la API usa la red Docker).
# Si necesitas conectar con un cliente SQL desde fuera, levanta también:
#   docker compose -f docker-compose.yml -f docker-compose.db-port.yml up -d
# y aquí define un puerto libre en el NAS:
# MYSQL_PORT=3307

# --- Red / acceso web --------------------------------------------------------
# Puerto del navegador: http://IP_del_NAS:WEB_PORT
# Synology DSM: si falla "driver failed programming external connectivity" en web-*,
# el puerto suele estar ocupado (muchas veces el 8080). Usa otro, p. ej. 18080 o 8888:
WEB_PORT=18080

# APP_BASE_URL debe coincidir con cómo entras (incluye :puerto si no es 80/443).
# Ej. LAN: APP_BASE_URL=http://192.168.1.10:18080

# Si el contenedor db queda "unhealthy" / "dependency failed to start":
# 1) Revisa logs: docker logs <nombre-proyecto>-db-1
# 2) Si CAMBIASTE MYSQL_ROOT_PASSWORD o MYSQL_PASSWORD después del primer arranque,
#    el volumen db_data ya tiene otras credenciales: borra el volumen del proyecto
#    (o solo *_db_data) y vuelve a desplegar — se pierden datos de BD.
# 3) Evita en contraseñas comillas simples/dobles o caracteres que rompan el shell.

# --- Base de datos MySQL (contenedor db) ------------------------------------
# DB_NAME de la API = MYSQL_DATABASE. El init de Docker crea tablas en esta base.
MYSQL_DATABASE=budget_manager
MYSQL_USER=budget

# Error 1045 (Access denied user 'budget'): el volumen Docker db_data se inicializó con
# otras MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD. Solución: borrar el volumen y recrear el stack,
# o cambiar la contraseña en MySQL con root (datos se conservan si haces ALTER USER).
# >>> MODIFICAR: contraseña del usuario de la aplicación (no uses la de ejemplo).
MYSQL_PASSWORD=budget_secret

# >>> MODIFICAR: contraseña del usuario root de MySQL.
MYSQL_ROOT_PASSWORD=root_secret

# --- API PHP (contenedor api) -----------------------------------------------
# URL pública de la app (enlaces en correo / recuperación). Debe coincidir con
# cómo entras en el navegador (incluye puerto si no usas 80/443).
# >>> MODIFICAR en NAS u otro host: p. ej. http://192.168.1.50:18080 o tu dominio HTTPS
APP_BASE_URL=http://localhost:18080

# Cookies seguras: 1 solo si sirves la app por HTTPS (p. ej. proxy inverso DSM).
# En http://IP:puerto deja 0.
COOKIE_SECURE=0

# Permite POST /api/auth/bootstrap para crear el primer admin si no hay ninguno.
# Pon 0 en producción cuando ya tengas administrador.
ALLOW_BOOTSTRAP=1
